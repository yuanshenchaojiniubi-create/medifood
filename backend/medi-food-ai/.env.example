# MediFood AI 模块环境变量配置
# 复制此文件为 .env 并填入实际的 API Key

# DeepSeek API 密钥（必填）
# 获取地址：https://platform.deepseek.com/api_keys
MEDIFOOD_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# SiliconFlow API 密钥（必填，用于 Embedding 和视觉模型）
# 获取地址：https://siliconflow.cn/account/ak
MEDIFOOD_SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# SiliconFlow 基础 URL（可选，默认 https://api.siliconflow.cn）
# MEDIFOOD_SILICONFLOW_BASE_URL=https://api.siliconflow.cn

# SiliconFlow 视觉模型（可选，默认 Qwen/Qwen3-VL-30B-A3B-Instruct）
# MEDIFOOD_SILICONFLOW_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# SiliconFlow Embedding 模型（可选，默认 BAAI/bge-large-zh-v1.5）
# MEDIFOOD_SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5