# ========== 安全：本地凭据与敏感文件（严禁提交） ==========
# 本地 VM 运维工具目录（含服务器账号/密码/部署脚本，整体勿上传）
tools/
# 本地密钥文件（部署机使用，勿上传）
api-keys.env
*.api-keys.env
# 简历与提取产物（含个人信息）
岳照原*.pdf
# JVM 线程转储（可能含请求数据）
*jstack*.txt
# 部署产物压缩包（含历史源码快照，勿提交）
tools/vm-deploy/*.tgz
# 用户上传文件
uploads/
# IDE 生成文件
*.factorypath
# AI 编辑器本地配置/文档（Cursor / Trae，含个人开发笔记）
.cursor/
.trae/
# SkyWalking Agent 二进制
skywalking/

